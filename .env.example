# Generate two different tokens: openssl rand -hex 32
CONTROL_TOKEN=replace-with-a-random-controller-token-at-least-32-characters
HOST_TOKEN=replace-with-a-different-random-host-token-at-least-32-characters
API_HOST=127.0.0.1
API_PORT=8787
# Exact browser origins allowed to use API / WebSocket. No trailing slash.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional TURN REST credentials (coturn use-auth-secret); needed across restrictive NATs.
# TURN_URL=turn:turn.example.com:3478
# TURN_SECRET=your-coturn-shared-secret
# STUN_URL=stun:stun.example.com:3478
