[Unit]
Description=Remote Console TURN relay
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=turnserver
Group=turnserver
LoadCredential=turn.conf:/etc/remote-console/turnserver.conf
ExecStart=/usr/bin/turnserver -c %d/turn.conf --pidfile=/run/remote-console-turn/turn.pid
RuntimeDirectory=remote-console-turn
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
