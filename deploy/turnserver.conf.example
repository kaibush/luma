# Copy to /etc/remote-console/turnserver.conf and fill the secret locally.
listening-port=3478
listening-ip=0.0.0.0
relay-ip=207.58.173.239
min-port=49200
max-port=49300
fingerprint
use-auth-secret
static-auth-secret=REPLACE_WITH_RANDOM_SECRET
realm=rc.lvyrix.com
no-cli
no-multicast-peers
no-tls
no-dtls
user-quota=8
total-quota=64
max-bps=1500000
stale-nonce=600
# Do not permit relaying into this machine's private service networks.
denied-peer-ip=0.0.0.0-0.255.255.255
denied-peer-ip=10.0.0.0-10.255.255.255
denied-peer-ip=127.0.0.0-127.255.255.255
denied-peer-ip=169.254.0.0-169.254.255.255
denied-peer-ip=172.16.0.0-172.31.255.255
denied-peer-ip=192.168.0.0-192.168.255.255
log-file=stdout
simple-log
